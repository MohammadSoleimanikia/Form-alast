{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },

  "include": [
    "src"
  ]
}